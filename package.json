{
  "name": "winner-apparels",
  "version": "1.0.0",
  "description": "Winner Apparels – export garment manufacturer website and business management system (React + Express + Supabase Postgres)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:demo": "vite build -c vite.artifact.config.ts && python build_artifact.py",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx server/migrate-cli.ts",
    "db:seed": "tsx server/seed-cli.ts",
    "images": "node scripts/generate-images.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.55.0",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
